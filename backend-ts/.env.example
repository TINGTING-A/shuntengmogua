# ==========================================
# 顺藤摸瓜 —— AI智能办公伙伴
# 环境变量配置清单
# ==========================================

# --- 认证 ---
JWT_SECRET=change-this-to-a-strong-secret-key-in-production
JWT_EXPIRES_IN=7d

# --- 数据库 ---
DATABASE_URL=file:./data/ai_chat.db
VECTOR_DB_PATH=./data/vector_db.sqlite

# --- LLM 大模型 API Keys (至少配置一个) ---
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
DEEPSEEK_API_KEY=sk-xxx
# Ollama 本地大模型 (可选)
OLLAMA_HOST=http://localhost:11434

# --- Mem0 记忆引擎 (可选) ---
# 注册: https://app.mem0.ai
MEM0_API_KEY=
# MEM0_HOST=           # 自部署地址(可选)

# --- BGE-M3 嵌入 (可选, 默认用Ollama) ---
EMBEDDING_API_BASE=http://localhost:11434
EMBEDDING_MODEL=bge-m3
# EMBEDDING_API_KEY=   # 如果用云端服务

# --- 语音服务 (可选) ---
WHISPER_API_BASE=http://localhost:11434   # Whisper/Ollama
WHISPER_MODEL=whisper-large-v3
FISH_SPEECH_API_BASE=http://localhost:8080  # Fish Speech
FISH_SPEECH_VOICE=default

# --- 连接器 ---
# Notion: https://www.notion.so/my-integrations
NOTION_API_KEY=
# 邮箱IMAP
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_USER=
EMAIL_PASS=
EMAIL_TLS=true
# 3D模型生成: Meshy API (可选)
MESHY_API_KEY=
# 浏览器自动化: Browser Use API (可选)
BROWSER_USE_API_KEY=
# 钉钉开放平台
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
# 飞书开放平台
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 企业微信
WECOM_CORP_ID=
WECOM_SECRET=
# WPS开放平台
WPS_APP_KEY=
WPS_APP_SECRET=

# --- 端口 ---
PORT=3000
